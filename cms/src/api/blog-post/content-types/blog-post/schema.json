{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "BlogPost"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "body": {
      "type": "text"
    },
    "postedAt": {
      "type": "datetime",
      "required": false
    },
    "publishStatus": {
      "type": "enumeration",
      "enum": [
        "Draft",
        "Published"
      ]
    }
  }
}