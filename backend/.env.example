# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Generate strong random values, e.g.: openssl rand -hex 32
# Do NOT reuse the same secret for both — they protect different token types.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# File storage driver: "local" for development, "cloudinary" for production.
# See src/utils/cloudStorage.js.
STORAGE_DRIVER=local
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Base URL of the mock-cms service (or real Strapi once it's ready).
CMS_API_URL=http://localhost:4001

# Leave unset to log emails to the console instead of sending them.
# EMAIL_PROVIDER_API_KEY=
STAFF_NOTIFICATION_EMAIL=staff@example.com

# Used only by `npm run seed` to create the first Admin account.
SEED_ADMIN_EMAIL=admin@sof2eze.test
SEED_ADMIN_PASSWORD=change-this-before-seeding

FRONTEND_URL=http://localhost:5173
