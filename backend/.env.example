# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Generate strong random values, e.g.: openssl rand -hex 32
# Do NOT reuse the same secret for both — they protect different token types.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# MongoDB Atlas connection string. Required — the app will not start without it.
# Create a free cluster at https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=

# File storage driver: "local" for development, "cloudinary" for production.
# See src/utils/cloudStorage.js.
STORAGE_DRIVER=local
# Required if STORAGE_DRIVER=cloudinary. Copy the "API Environment variable"
# value directly from your Cloudinary dashboard.
# Note: new Cloudinary accounts block raw file (PDF/ZIP) delivery by default —
# enable it under Settings > Security > "PDF and ZIP files delivery".
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Base URL of the CMS (Strapi).
CMS_API_URL=http://localhost:1337

# SMTP credentials for real email delivery. Leave unset to use a free
# Ethereal test account instead (emails captured in a web UI, not delivered).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Sof2eze" <noreply@sof2eze.com>
STAFF_NOTIFICATION_EMAIL=staff@example.com

# Used only by `npm run seed` to create the first Admin account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

FRONTEND_URL=http://localhost:5173